CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 16 MB / 8 MB Octal PSRAM (required for LVGL canvas, playback ring buffer, and ESP-SR)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# FreeRTOS and system tasks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_MAX_SOCKETS=10

# Wi-Fi tuning for low-latency LAN PCM streaming with low internal RAM footprint
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# LVGL / Display (single internal DMA strip avoids per-frame SPI bounce mallocs)
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=20
CONFIG_LV_USE_PERF_MONITOR=n

# ESP-SR local WakeNet9 + AEC + NS + VAD
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HIESP=y

# GrokBot Body defaults
CONFIG_GROKBOT_WIFI_SSID=""
CONFIG_GROKBOT_WIFI_PASSWORD=""
CONFIG_GROKBOT_BRAIN_HOST=""
CONFIG_GROKBOT_BRAIN_PORT=8765
CONFIG_GROKBOT_DEVICE_ID="vocat-desk"
CONFIG_GROKBOT_USE_ESP_SR=y
CONFIG_GROKBOT_DEMO_FACE_ONLY=n
