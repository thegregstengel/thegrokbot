# Copy to secrets.env (gitignored) for running brain/grokbot-brain.
# Keys live only on your Brain host, never on the ESP-VoCat microcontroller.
XAI_API_KEY=xai-your-key-here
# Shared pairing secret for mutual HMAC-SHA256 auth between Body and Brain.
# Generate one with: openssl rand -hex 24
GROKBOT_AUTH_TOKEN=replace-with-random-hex-token
GROKBOT_LISTEN=0.0.0.0:8765
GROKBOT_XAI_VOICE=eve
GROKBOT_XAI_MODEL=grok-voice-latest
# Set to 1 to log full voice transcripts at INFO level (off by default).
# GROKBOT_LOG_TRANSCRIPTS=0
